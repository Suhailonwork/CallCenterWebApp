[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060

[transport-wss]
type=transport
protocol=wss
bind=0.0.0.0

[6001]
type=endpoint
transport=transport-wss
aors=6001
auth=6001-auth
context=from-webrtc
disallow=all
allow=ulaw,alaw
webrtc=yes
dtls_auto_generate_cert=yes

[6001-auth]
type=auth
auth_type=userpass
username=6001
password=webrtcpass

[6001]
type=aor
max_contacts=1
remove_existing=yes


[dinstar]
type=endpoint
transport=transport-udp
context=from-dinstar
disallow=all
allow=ulaw,alaw
aors=dinstar
direct_media=no
rtp_symmetric=yes
rewrite_contact=yes

[dinstar]
type=aor
contact=sip:192.168.0.247:5060
qualify_frequency=30

[dinstar]
type=identify
endpoint=dinstar
match=192.168.0.247
