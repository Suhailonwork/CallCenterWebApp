[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060

[transport-wss]
type=transport
protocol=wss
bind=0.0.0.0:8089
external_signaling_address=192.168.0.101
external_media_address=192.168.0.101
allow_reload=yes

[7001]
type=endpoint
transport=transport-udp
context=from-internal
disallow=all
allow=ulaw,alaw
aors=7001
auth=7001-auth
direct_media=no

[7001-auth]
type=auth
auth_type=userpass
username=7001
password=7001pass

[7001]
type=aor
max_contacts=2

[1100]
type=endpoint
transport=transport-wss
context=from-internal
disallow=all
allow=opus,ulaw
aors=1100
auth=1100
webrtc=yes
media_encryption=dtls
ice_support=yes
rtcp_mux=yes
rewrite_contact=yes
rtp_symmetric=yes
force_rport=yes
direct_media=no

[1100]
type=auth
auth_type=userpass
username=1100
password=StrongPass123

[1100]
type=aor
max_contacts=1
remove_existing=yes

[7000]
type=endpoint
context=from-external
disallow=all
allow=ulaw
transport=transport-udp
auth=7000
aors=7000

[7000]
type=auth
auth_type=userpass
password=7000
username=7000

[7000]
type=aor
max_contacts=1

[8888]
type=endpoint
transport=transport-udp
context=from-internal
disallow=all
allow=ulaw,alaw
aors=8888
auth=8888-auth
direct_media=no

[8888-auth]
type=auth
auth_type=userpass
username=8888
password=8888

[8888]
type=aor
max_contacts=1

[genral]
#include pjsip.d/*.conf
#include pjsip_trunks.d/*.conf
